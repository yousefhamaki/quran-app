{
  "expo": {
    "name": "Quran | القرآن",
    "slug": "quran-app",
    "scheme": "quranapp",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b5d4b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Anspire.Quran",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.Anspire.Quran",
      "adaptiveIcon": {
        "backgroundColor": "#0b5d4b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b5d4b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0b5d4b",
          "defaultChannel": "daily-ayah",
          "sounds": [
            "./assets/sounds/adhan.wav"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "AyahOfDay",
              "displayName": "Ayah of the day",
              "description": "A new ayah every day",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "AyahOfDay",
              "label": "Ayah of the day",
              "description": "A new ayah every day",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-work-runtime-fix",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used only on your phone to calculate prayer times and the Qibla direction."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
